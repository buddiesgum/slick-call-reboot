{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hukills",
	// Set to today's date; update when raising compatibility flags.
	"compatibility_date": "2026-04-23",
	// Worker entry — handles /api/* routes; all other requests fall through to
	// the asset binding below. See worker/index.ts for the dispatch table.
	"main": "worker/index.ts",
	"assets": {
		// vite-react-ssg builds to dist/ with dirStyle "nested":
		//   dist/about/index.html, dist/contact/index.html, etc.
		// auto-trailing-slash resolves folder-index files automatically.
		"directory": "./dist",
		// Binding name used in worker/index.ts (env.ASSETS.fetch) so the Worker
		// can delegate non-API requests back to the static asset router.
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	// Cloudflare Email Sending binding (env.EMAIL.send).
	// PRODUCTION PREREQUISITE: hukills.com must be added as a verified sender in
	// Cloudflare dashboard → Email → Email Sending with SPF/DKIM/DMARC records
	// published before production sends will succeed. `wrangler dev` mocks the
	// binding locally — sends are logged, not actually delivered.
	"send_email": [{ "name": "EMAIL" }],
	// Custom domains (hukills.com, www.hukills.com) are managed in the
	// Cloudflare dashboard under Workers & Pages > hukills > Settings > Domains.,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
