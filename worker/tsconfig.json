{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"lib": ["ES2022", "WebWorker"],
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"paths": {
			"@/*": ["../src/*"]
		},
		"skipLibCheck": true,
		"target": "ES2022",
		"types": ["@cloudflare/workers-types"]
	},
	"include": [
		"index.ts",
		"lib/**/*.ts",
		"routes/**/*.ts",
		"../worker-configuration.d.ts",
		"env-extra.d.ts"
	]
}
